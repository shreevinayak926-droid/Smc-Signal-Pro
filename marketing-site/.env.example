# SMC Signal Pro - Unified Application Environment Variables
# Used by both the Marketing Website and the SMC Signal Pro Trading Platform / Admin Portal.
# In Vercel, set these in: Project Settings > Environment Variables

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Gemini AI API Key for real-time market structure & automated AI trade scans
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
